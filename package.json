{
  "name": "app-document",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "df-dev-env && dotenv -- zellij --layout .zellij.kdl",
    "dev-server": "df-dev-server",
    "dev-app": "vite",
    "build": "vite build",
    "build-test": "PUBLIC_URL=https://staging-koumoul.com/apps/documents/master/ vite build",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "type-check": "vue-tsc --noEmit",
    "build-types": "df-build-types src/config",
    "test": "df-dev-env && dotenv -- playwright test --max-failures=1",
    "test-unit": "playwright test --project unit",
    "test-e2e": "df-dev-env && dotenv -- playwright test --project e2e",
    "quality": "npm run lint && npm run build-types && npm run type-check && npm run build && npm test && npm audit --omit=dev --audit-level=critical"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@data-fair/lib-utils": "^1.13.1",
    "@data-fair/lib-vue": "^1.30.1",
    "@data-fair/lib-vuetify": "^2.4.3",
    "@mdi/font": "^7.4.47",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "file-saver": "^2.0.5",
    "ofetch": "^1.5.1",
    "reconnecting-websocket": "^4.4.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.4",
    "vuetify": "^4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@data-fair/dev-server": "^2.6.2",
    "@data-fair/lib-common-types": "^1.23.0",
    "@data-fair/lib-types-builder": "^1.14.3",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.63.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.10.1",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "husky": "^9.1.7",
    "neostandard": "^0.13.0",
    "sass-embedded": "^1.97.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.11"
  }
}
