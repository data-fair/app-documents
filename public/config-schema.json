{
  "type": "object",
  "x-exports": [
    "types"
  ],
  "allOf": [
    {
      "title": "Documents",
      "properties": {
        "datasets": {
          "type": "array",
          "title": "Jeu de données",
          "description": "Laisser vide : la GED crée et gère son propre jeu de données, rattaché à l'application. Attention, supprimer l'application supprime ce jeu de données et tous ses documents. Sélectionnez un jeu de données uniquement pour réutiliser une GED existante : éditable (REST), avec une pièce jointe et les colonnes path et nom.",
          "layout": {
            "getItems": {
              "url": "api/v1/datasets?status=finalized&rest=true&short-concept=attachment&select=id,title&size=50&${context.datasetFilter}",
              "itemKey": "data.href",
              "itemTitle": "data.title",
              "itemsResults": "data.results",
              "qSearchParam": "q"
            }
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "href": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "finalizedAt": {
                "type": "string"
              },
              "applicationKeyPermissions": {
                "type": "object"
              },
              "managedByApp": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "title": "Métadonnées",
      "properties": {
        "metadata": {
          "type": "array",
          "title": "Champs de métadonnées",
          "description": "Champs supplémentaires associés à chaque document. Ils sont créés comme colonnes du jeu de données et sont inclus dans la recherche.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title"
            ],
            "properties": {
              "key": {
                "type": "string",
                "title": "Identifiant technique",
                "description": "Lettres, chiffres et tirets bas uniquement, sans accent ni espace.",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
                "layout": {
                  "cols": {
                    "sm": 6
                  }
                }
              },
              "title": {
                "type": "string",
                "title": "Libellé",
                "layout": {
                  "cols": {
                    "sm": 6
                  }
                }
              },
              "type": {
                "type": "string",
                "title": "Type",
                "default": "string",
                "oneOf": [
                  {
                    "const": "string",
                    "title": "Texte"
                  },
                  {
                    "const": "number",
                    "title": "Nombre"
                  },
                  {
                    "const": "boolean",
                    "title": "Booléen"
                  },
                  {
                    "const": "date",
                    "title": "Date"
                  }
                ],
                "layout": {
                  "cols": {
                    "sm": 6
                  }
                }
              },
              "required": {
                "type": "boolean",
                "title": "Obligatoire",
                "default": false,
                "layout": {
                  "cols": {
                    "xs": 6
                  }
                }
              },
              "searchable": {
                "type": "boolean",
                "title": "Inclus dans la recherche",
                "default": true,
                "layout": {
                  "cols": {
                    "xs": 6
                  },
                  "if": "!parent.data.type || parent.data.type === 'string' || parent.data.type === 'number'"
                }
              },
              "showInTable": {
                "type": "boolean",
                "title": "Afficher dans le tableau",
                "default": true,
                "layout": {
                  "cols": {
                    "xs": 6
                  }
                }
              }
            }
          },
          "layout": {
            "itemTitle": "data.title || data.key",
            "messages": {
              "addItem": "Ajouter un champ"
            }
          }
        }
      }
    }
  ]
}
