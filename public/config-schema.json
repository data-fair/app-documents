{
  "type": "object",
  "required": [
    "datasets"
  ],
  "x-exports": [
    "types"
  ],
  "allOf": [
    {
      "title": "Source de données",
      "properties": {
        "datasets": {
          "type": "array",
          "title": "Jeu de données",
          "description": "Sélectionnez le jeu de données contenant les documents, il doit contenir au moins une pièce jointe (concept attachment)",
          "layout": {
            "getItems": {
              "url": "api/v1/datasets?status=finalized&short-concept=attachment&q={q}&select=id,title&size=100&${context.datasetFilter}",
              "itemKey": "data.href",
              "itemTitle": "data.title",
              "itemsResults": "data.results"
            }
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "href": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "finalizedAt": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
